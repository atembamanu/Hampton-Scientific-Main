# Copy to ".env" at the repo root and fill in real values. Never commit .env.

# Comma-separated, no wrapping quotes in Dokploy. List every site users open (www + apex if both exist).
# Frontend https://www.example.com + API https://api.example.com → origins are the FRONTEND URLs only.
CORS_ORIGINS=http://localhost:3001
# Optional: regex fallback if Origin must match both www and apex (single backslashes in .env)
# CORS_ORIGIN_REGEX=https://(www\.)?example\.com

# Outbound email — Zoho SMTP (info@hamptonscientific.com).
# Zoho: SMTP_HOST=smtp.zoho.com (or smtppro.zoho.com / smtp.zoho.eu), port 465 + SSL, or 587 + SMTP_USE_SSL=false
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=info@hamptonscientific.com
# With Zoho MFA, use an application-specific password here (or in SMTP_APP_PASSWORD).
SMTP_PASSWORD=
SMTP_APP_PASSWORD=
SMTP_USE_SSL=true
SENDER_EMAIL=Hampton Scientific <info@hamptonscientific.com>
# Fallback inbox for quote/contact/training alerts if Admin Settings → Email is empty
ADMIN_EMAIL=info@hamptonscientific.com

FRONTEND_URL=http://localhost:3001
SECRET_KEY=generate-a-long-random-string

# Company time zone (IANA name). Timestamps are stored in UTC; this zone is used for API output
# offsets, PDF/email dates, document reference dates (QT/ORD/IN + YYYYMMDD) and date-range filters.
# Browsers still render times in the viewer's own PC time zone.
APP_TIMEZONE=Africa/Nairobi

# Postgres (Docker Compose + backend DATABASE_URL)
POSTGRES_DB=hampton_scientific
POSTGRES_USER=hs_user
POSTGRES_PASSWORD=changeme
# Docker Compose: host is the service name "postgres". Local Python: use localhost
DATABASE_URL=postgresql+psycopg2://hs_user:changeme@postgres:5432/hampton_scientific

# Frontend — dev server port (Craco reads repo-root .env; Docker sets PORT in Dockerfile)
PORT=3001

# Inlined at Docker *build* time only (yarn build / frontend image). Runtime env does NOT change the bundle.
# Local Compose: set this in .env so docker compose passes it as a build arg.
# Dokploy: set the same value under Build Arguments / Docker build args for the frontend service.
# Use your public API URL, e.g. https://api.example.com or https://www.example.com:8001
REACT_APP_BACKEND_URL=http://localhost:8001
